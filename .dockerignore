# Docker build context exclusions for this pnpm monorepo.
# Docker builds run with the repo root as build context (required so pnpm
# workspace links across artifacts/* and lib/* resolve correctly), so this
# file keeps that context small and avoids invalidating layer caches with
# local build output.

# dependencies (installed fresh inside the image)
node_modules
**/node_modules

# compiled output (rebuilt inside the image)
dist
**/dist
tmp
out-tsc
*.tsbuildinfo
**/*.tsbuildinfo

# version control
.git
.gitignore

# editors / IDEs
.vscode
.idea

# local env files (never bake secrets into an image)
.env
.env.*
!.env.example

# misc
.DS_Store
npm-debug.log
yarn-error.log
*.log

# Replit / platform-specific artifacts not needed for Docker builds
.replit-artifact
.artifact
.cache
.local

# Kilo / agent tooling config, not needed at build time
.kilo
.agents

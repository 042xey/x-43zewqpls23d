// ============================================================================
// TYPES & INTERFACES
// ============================================================================

interface WorkerConfig {
  template: string;
  clientAlias: string;
  apiServerUrl: string;
  frontendUrl: string;
}

interface RateLimitConfig {
  max: number;
  window: number;
}

interface RateLimitCheckResponse {
  allowed: boolean;
  count: number;
  limit: number;
  remaining: number;
}

// ============================================================================
// RATE LIMITER DURABLE OBJECT
// ============================================================================

export class RateLimiter {
  private state: DurableObjectState;

  private readonly LIMITS: Record<string, RateLimitConfig> = {
    generatecode: { max: 1, window: 86400000 },
    regeneratecode: { max: 3, window: 86400000 },
  };

  constructor(state: DurableObjectState) {
    this.state = state;
  }

  async fetch(request: Request): Promise<Response> {
    try {
      const { ip, endpoint } = (await request.json()) as {
        ip: string;
        endpoint: string;
      };

      const now = Date.now();
      const config = this.LIMITS[endpoint] || this.LIMITS.generatecode;
      const windowStart = Math.floor(now / config.window) * config.window;
      const key = `${ip}:${endpoint}:${windowStart}`;

      let count = ((await this.state.storage.get(key)) as number | null) || 0;
      count++;

      await this.state.storage.put(key, count, {
        expirationTtl: Math.ceil(config.window / 1000),
      });

      const response: RateLimitCheckResponse = {
        allowed: count <= config.max,
        count,
        limit: config.max,
        remaining: Math.max(0, config.max - count),
      };

      return Response.json(response);
    } catch (error) {
      console.error("RateLimiter error:", error);
      return Response.json({ error: "Rate limiter error" }, { status: 500 });
    }
  }
}

// ============================================================================
// WORKER SCRIPT GENERATOR
// ============================================================================

export function generateWorkerScript(config: WorkerConfig): string {
  const apiUrl = config.apiServerUrl.replace(/\/$/, "");
  const frontendUrl = config.frontendUrl.replace(/\/$/, "");

  return `
// Auto-generated Cloudflare Worker with Rate Limiting
// Generated at: ${new Date().toISOString()}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const API_ORIGIN = ${JSON.stringify(apiUrl)};
    const FRONTEND_ORIGIN = ${JSON.stringify(frontendUrl)};
    const TEMPLATE = ${JSON.stringify(config.template)};
    const CLIENT_ALIAS = ${JSON.stringify(config.clientAlias)};

    const clientIp = request.headers.get('CF-Connecting-IP') || 'unknown';

    // ========================================================================
    // HELPER: Check rate limit
    // ========================================================================
    async function checkRateLimit(endpoint) {
      const id = env.RATE_LIMITER.idFromName(clientIp);
      const limiter = env.RATE_LIMITER.get(id);
      const rateLimitCheck = await limiter.fetch(
        new Request('http://localhost', {
          method: 'POST',
          body: JSON.stringify({ ip: clientIp, endpoint }),
        })
      );
      return await rateLimitCheck.json();
    }

    // ========================================================================
    // ENDPOINT: /api/template (GET) - No rate limit
    // ========================================================================
    if (url.pathname === '/api/template' && request.method === 'GET') {
      return Response.json(
        { template: TEMPLATE },
        { headers: { 'Access-Control-Allow-Origin': '*' } }
      );
    }

    // ========================================================================
    // ENDPOINT: /api/generatecode (GET) - 1 request per day per IP
    // ========================================================================
    if (url.pathname === '/api/generatecode' && request.method === 'GET') {
      const rateLimitData = await checkRateLimit('generatecode');

      if (!rateLimitData.allowed) {
        return Response.json(
          {
            error: 'Rate limit exceeded',
            message: 'Maximum 1 code generation per day',
            remaining: rateLimitData.remaining,
          },
          {
            status: 429,
            headers: { 'Retry-After': '86400' },
          }
        );
      }

      try {
        const targetUrl = new URL(API_ORIGIN + '/api/generatecode');
        targetUrl.searchParams.set('app', CLIENT_ALIAS);
        const res = await fetch(targetUrl.toString(), {
          cf: { cacheEverything: false },
        });
        const data = await res.json();
        return Response.json(data, {
          status: res.ok ? 200 : res.status,
          headers: { 'Access-Control-Allow-Origin': '*' },
        });
      } catch (e) {
        console.error('generatecode error:', e);
        return Response.json(
          { error: 'Failed to reach API server' },
          { status: 502 }
        );
      }
    }

    // ========================================================================
    // ENDPOINT: /api/regeneratecode (POST) - 3 requests per day per IP
    // ========================================================================
    if (url.pathname === '/api/regeneratecode' && request.method === 'POST') {
      const rateLimitData = await checkRateLimit('regeneratecode');

      if (!rateLimitData.allowed) {
        return Response.json(
          {
            error: 'Rate limit exceeded',
            message: 'Maximum 3 code regenerations per day',
            remaining: rateLimitData.remaining,
          },
          {
            status: 429,
            headers: { 'Retry-After': '86400' },
          }
        );
      }

      try {
        const res = await fetch(API_ORIGIN + '/api/regeneratecode', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ app: CLIENT_ALIAS }),
        });
        const data = await res.json();
        return Response.json(data, {
          status: res.ok ? 200 : res.status,
          headers: { 'Access-Control-Allow-Origin': '*' },
        });
      } catch (e) {
        console.error('regeneratecode error:', e);
        return Response.json(
          { error: 'Failed to reach API server' },
          { status: 502 }
        );
      }
    }

    // ========================================================================
    // FALLBACK: Transparent proxy to frontend
    // ========================================================================
    try {
      const proxyUrl = FRONTEND_ORIGIN + url.pathname + url.search;
      const proxyInit = {
        method: request.method,
        headers: request.headers,
        body: ['GET', 'HEAD'].includes(request.method)
          ? undefined
          : request.body,
        redirect: 'follow',
      };
      const originRes = await fetch(proxyUrl, proxyInit);
      return new Response(originRes.body, {
        status: originRes.status,
        statusText: originRes.statusText,
        headers: originRes.headers,
      });
    } catch (e) {
      console.error('proxy error:', e);
      return new Response('502 Bad Gateway', { status: 502 });
    }
  },
};
`;
}
